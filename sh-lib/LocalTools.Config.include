#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

### in your scripts you can pull in user overrides via:
###   if [ -f "$MMDAPP/.local/home/$(id -un)/MDLT.settings.env" ]; then
###	 . "$MMDAPP/.local/home/$(id -un)/MDLT.settings.env"
###   fi
###

while true ; do case "$1" in
	--.local-config-option-select-default)
		# key=$2; val=$3; shift 3
		local cfgSelectKey="$2" cfgSelectFile cfgSelectLine cfgSelectFound=''
		local cfgSelectUserFile=''
		if [ -d "$MMDAPP/.local/home" ] ; then
			cfgSelectUserFile="$MMDAPP/.local/home/$( id -un )/MDLT.settings.env"
		fi
		for cfgSelectFile in "$cfgSelectUserFile" "$MMDAPP/.local/MDLT.settings.env" ; do
			[ -n "$cfgSelectFile" ] || continue
			[ -f "$cfgSelectFile" ] || continue
			while IFS= read -r cfgSelectLine || [ -n "$cfgSelectLine" ] ; do
				case "$cfgSelectLine" in
					"$cfgSelectKey="*)
						printf '%s\n' "${cfgSelectLine#*=}"
						cfgSelectFound=1
						break
					;;
				esac
			done < "$cfgSelectFile"
			[ -z "$cfgSelectFound" ] || break
		done
		[ -n "$cfgSelectFound" ] || printf '%s\n' "$3"
		shift 3; return 0
	;;
	--*-config-option)
		local config_file config_mode
		local cmd key val ifval curr tmp
		local cfgLine cfgLast cfgFound

		# pick target & ensure stub files exist
		case "$1" in
			--system-config-option)
				config_file="$MMDAPP/.local/MDLT.settings.env"
				mkdir -p "${config_file%/*}" || return 1
				touch "$config_file"
			;;
			--custom-config-option)
				config_file="$MMDAPP/.local/home/$(id -un)/MDLT.settings.env"
				mkdir -p "${config_file%/*}" || return 1
				touch "$config_file"
			;;
			--remote-config-option)
				: ${2:?"⛔ ERROR: $1 requires remote-id argument to follow!"}
				key="$2" ; shift
				config_file="$MMDAPP/remote/static/${key}.remote.env"
				mkdir -p "${config_file%/*}" || return 1
				touch "$config_file"
			;;
			--agents-config-option)
				: ${2:?"⛔ ERROR: $1 requires entity-id argument to follow!"}
				key="$2" ; shift
				config_file="$MMDAPP/.local/.agents/${key}.agent.env"
				config_mode="600"
				mkdir -p "${config_file%/*}" || return 1
				chmod 700 "${config_file%/*}" || return 1
				touch "$config_file"
				chmod "$config_mode" "$config_file" || return 1
			;;
			--*-config-option)
				echo "⛔ ERROR: unsupported config scope '$1'" >&2
				return 1
			;;
		esac

		# shift past the scope flag, grab the sub-command
		shift
		cmd=$1; shift

		# prepare temp‐files & ensure cleanup

		case "$cmd" in
		--select-all)
			while IFS= read -r cfgLine || [ -n "$cfgLine" ] ; do
				[ -n "$cfgLine" ] || continue
				case "$cfgLine" in '#'*) continue ;; esac
				case "${cfgLine#?}" in *=*) printf '%s\n' "$cfgLine" ;; esac
			done < "$config_file"
			;;

		--select)
			if [ "$1" = --all ]; then
			while IFS= read -r cfgLine || [ -n "$cfgLine" ] ; do
				[ -n "$cfgLine" ] || continue
				case "$cfgLine" in '#'*) continue ;; esac
				case "${cfgLine#?}" in *=*) printf '%s\n' "$cfgLine" ;; esac
			done < "$config_file"
			else
			cfgLast='' ; cfgFound=''
			while IFS= read -r cfgLine || [ -n "$cfgLine" ] ; do
				case "$cfgLine" in "$1="*) cfgLast="$cfgLine" ; cfgFound=1 ;; esac
			done < "$config_file"
			[ -z "$cfgFound" ] || printf '%s\n' "${cfgLast#*=}"
			fi
			shift
			;;

		--select-default)
			key=$1; val=$2 ;
			shift 2
			cfgLast='' ; cfgFound=''
			while IFS= read -r cfgLine || [ -n "$cfgLine" ] ; do
				case "$cfgLine" in "$key="*) cfgLast="$cfgLine" ; cfgFound=1 ;; esac
			done < "$config_file"
			if [ -n "$cfgFound" ] ; then
				printf '%s\n' "${cfgLast#*=}"
			else
				printf '%s\n' "$val"
			fi
			;;

		--upsert)
			key=$1; val=$2
			shift 2
			(
				tmp="$config_file.$$"
				trap 'rm -f -- "$tmp"' EXIT
				## Create+harden the temp file BEFORE writing content into it,
				## so a credential-bearing scope (config_mode set) never has
				## even a brief window where its replacement file is
				## world/group-readable. `mv`/rename(2) carries the SOURCE
				## file's own permission bits onto the destination path, so
				## a chmod applied only once at scope-setup time (on the
				## original file) gets silently wiped by the very first
				## mutation -- confirmed live: dir came out 700 correctly,
				## but the file itself landed 644 after a real --upsert run,
				## because the old code chmod'd the touched file, not the
				## temp file that actually replaces it.
				: > "$tmp"
				[ -z "$config_mode" ] || chmod "$config_mode" "$tmp"
				while IFS= read -r cfgLine || [ -n "$cfgLine" ] ; do
					case "$cfgLine" in "$key="*) ;; *) printf '%s\n' "$cfgLine" ;; esac
				done < "$config_file" >>"$tmp"
				printf '%s=%s\n' "$key" "$val" >>"$tmp"
				mv "$tmp" "$config_file"
			)
			;;

		--upsert-from-stdin)
			key=$1
			shift
			: ${key:?"⛔ ERROR: --upsert-from-stdin requires <key> argument to follow!"}
			## value never touches argv; $( ) drops every trailing newline
			val="$( cat )"
			case "$val" in
			"")
				echo "⛔ ERROR: --upsert-from-stdin: empty value on stdin for key '$key'" >&2
				set +e ; return 1
			;;
			esac
			# check that value does not contains newline(s)
			[ "${val%%$'\n'*}" = "$val" ] || {
				echo "⛔ ERROR: --upsert-from-stdin: value for key '$key' contains a newline" >&2
				set +e ; return 1
			}
			(
				tmp="$config_file.$$"
				trap 'rm -f -- "$tmp"' EXIT
				## harden BEFORE content: mv carries the SOURCE file's bits
				: > "$tmp"
				[ -z "$config_mode" ] || chmod "$config_mode" "$tmp"
				while IFS= read -r cfgLine || [ -n "$cfgLine" ] ; do
					case "$cfgLine" in "$key="*) ;; *) printf '%s\n' "$cfgLine" ;; esac
				done < "$config_file" >>"$tmp"
				printf '%s=%s\n' "$key" "$val" >>"$tmp"
				mv "$tmp" "$config_file"
			)
			;;

		--upsert-if)
			key=$1 ; val=$2 ; ifval=$3
			shift 3
			cfgLast='' ; cfgFound=''
			while IFS= read -r cfgLine || [ -n "$cfgLine" ] ; do
				case "$cfgLine" in "$key="*) cfgLast="$cfgLine" ; cfgFound=1 ;; esac
			done < "$config_file"
			if [ -n "$cfgFound" ] ; then curr="${cfgLast#*=}" ; else curr='' ; fi
			[ "$curr" != "$ifval" ] || (
				tmp="$config_file.$$"
				trap 'rm -f -- "$tmp"' EXIT
				: > "$tmp"
				[ -z "$config_mode" ] || chmod "$config_mode" "$tmp"
				while IFS= read -r cfgLine || [ -n "$cfgLine" ] ; do
					case "$cfgLine" in "$key="*) ;; *) printf '%s\n' "$cfgLine" ;; esac
				done < "$config_file" >>"$tmp"
				printf '%s=%s\n' "$key" "$val" >>"$tmp"
				mv "$tmp" "$config_file"
			)
			;;

		--delete)
			key=$1
			shift
			(
				tmp="$config_file.$$"
				trap 'rm -f -- "$tmp"' EXIT
				: > "$tmp"
				[ -z "$config_mode" ] || chmod "$config_mode" "$tmp"
				while IFS= read -r cfgLine || [ -n "$cfgLine" ] ; do
					case "$cfgLine" in "$key="*) ;; *) printf '%s\n' "$cfgLine" ;; esac
				done < "$config_file" >>"$tmp"
				mv "$tmp" "$config_file"
			)
			;;

		--delete-if)
			key=$1 ; ifval=$2
			shift 2
			cfgLast='' ; cfgFound=''
			while IFS= read -r cfgLine || [ -n "$cfgLine" ] ; do
				case "$cfgLine" in "$key="*) cfgLast="$cfgLine" ; cfgFound=1 ;; esac
			done < "$config_file"
			if [ -n "$cfgFound" ] ; then curr="${cfgLast#*=}" ; else curr='' ; fi
			[ "$curr" != "$ifval" ] || (
				tmp="$config_file.$$"
				trap 'rm -f -- "$tmp"' EXIT
				: > "$tmp"
				[ -z "$config_mode" ] || chmod "$config_mode" "$tmp"
				while IFS= read -r cfgLine || [ -n "$cfgLine" ] ; do
					case "$cfgLine" in "$key="*) ;; *) printf '%s\n' "$cfgLine" ;; esac
				done < "$config_file" >>"$tmp"
				mv "$tmp" "$config_file"
			)
			;;

		*)
			echo "⛔ ERROR: unknown config operation '$cmd'" >&2
			set +e ; return 1
			;;
		esac

		return 0
		;;

	*)
		return 0
		;;
esac done
