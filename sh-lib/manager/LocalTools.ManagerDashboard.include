#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## LocalTools.ManagerDashboard.include -- the --manager-dashboard-read operation (F11.4 of the refactorings epic): the Dashboard, a super-system
## of the console that `.local` owns. Sourced by the `--manager-dashboard-*)` arm of the dispatcher of any console of the family, each of which says in
## `managerConsoleDashboardList` the plain list file in which its subsystem declares its panels; who may call was asked where the family is dispatched.
##
## A PANEL is a small set of FIGURES under one label, a `block` of the rows this operation prints; a screen draws it with no knowledge of what is in it:
## every figure carries its own label, its unit, a level and, where it is a part of a whole, the share it is of it, for a bar. A panel that has no honest
## figure on this host is left out, never guessed. A SUBSYSTEM REGISTERS ITS PANELS by declaring them in its list file, and the reader of each, a function,
## which is its own (a subsystem's include) or is `.local`'s (The Machine, Disk Space): the list is plain text, so what a console offers is printed with no
## python. The list holds two kinds of line, TAB-separated, with `#` lines and blank lines left alone:
##   group <id> <label> <when> <include>
##       a Dashboard submenu: <label> is what the screen calls it, capitalised words with their blanks written `_`; <when> the function that says, by its
##       rc, whether it applies on this host (`-` for always), defined in <include>, a file under myx/ of the origin (`-` for none).
##   panel <group> <name> <label> <reader> <include> <read>
##       a panel of a group, `root` being the Dashboard itself: the reader is a function defined in <include> (`-` where it is `.local`'s own); <read> is
##       `named` for a panel printed only where it is asked for by its name, never in the read of every panel of its group, or `-`.
## The readers write figures with LocalToolsManagerDashboardFigure and take their time from dashboardNow.
##
## FOR VIEWING, AND CHEAP: a screen reads it every ten seconds. NO git command is run unless a panel is asked for by its name and declares itself so, and
## nothing reaches another host. A SECRET IS NEVER PRINTED and none is read for the figures of `.local`.
##

## THE THRESHOLDS of a level, each pair `warn` from the first and `bad` from the second.
## A volume and the memory by the share that is used, in percent. The load by what it is of
## the processors, in percent: 100 is one runnable process for each of them.
localManagerDashboardDiskWarn=85
localManagerDashboardDiskBad=95
localManagerDashboardMemoryWarn=90
localManagerDashboardMemoryBad=97
localManagerDashboardLoadWarn=100
localManagerDashboardLoadBad=200

## The volumes the subsystem asks Disk Space to show besides the workspace and its temp folder: a line each, `<name> TAB <label> TAB <path>`, the label
## in capitalised words with their blanks written `_`. Set by the reader of the subsystem that registers Disk Space, ahead of calling it.
localManagerDashboardDiskVolumes=""

## One `figure` row of the block being read, into dashboardRows of the operation, counted
## in dashboardCount. Every field is made one field: its whitespace reads `_`, and an empty
## one reads `-`, as in a registry.
LocalToolsManagerDashboardFigure(){ ## block, figure, label, value, unit, level, share (may be empty)
	local figureField figureRow="figure" figureTab=$'\t'
	for figureField in "$1" "$2" "$3" "${4:-}" "${5:-}" "${6:-}" "${7:-}" ; do
		figureField="${figureField//[[:space:]]/_}"
		figureRow="$figureRow$figureTab${figureField:--}"
	done
	dashboardRows="$dashboardRows$figureRow"$'\n'
	dashboardCount=$(( dashboardCount + 1 ))
	return 0
}

## The level of a share by a pair of thresholds, in dashboardLevel: `bad` from the second,
## `warn` from the first, `ok` under it, and `-` for what is no whole number.
LocalToolsManagerDashboardLevel(){ ## share, warn from, bad from
	dashboardLevel="-"
	case "${1:-}" in ''|*[!0123456789]*) return 0 ;; esac
	if [ "$1" -ge "$3" ] ; then dashboardLevel="bad" ; elif [ "$1" -ge "$2" ] ; then dashboardLevel="warn" ; else dashboardLevel="ok" ; fi
	return 0
}

## What a part is of a whole, in dashboardShare: a whole number from 0 to 100, empty where
## either is no whole number or the whole is nothing.
LocalToolsManagerDashboardShare(){ ## part, whole
	dashboardShare=""
	case "${1:-}" in ''|*[!0123456789]*) return 0 ;; esac
	case "${2:-}" in ''|*[!0123456789]*|0) return 0 ;; esac
	dashboardShare=$(( $1 * 100 / $2 ))
	[ "$dashboardShare" -le 100 ] || dashboardShare=100
	return 0
}

## How long ago a moment was, in seconds, in dashboardAge: by the one ISO reader
## (LocalIsoToEpoch.awk). Empty where the text is no such date, or lies ahead of now.
LocalToolsManagerDashboardAge(){ ## a date and time as the ISO reader takes it
	local ageEpoch
	dashboardAge=""
	case "${1:-}" in [0123456789][0123456789][0123456789][0123456789]-[01][0123456789]-[0123][0123456789]*) ;; *) return 0 ;; esac
	ageEpoch="$( printf '%s\n' "$1" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/output/LocalIsoToEpoch.awk" 2> /dev/null )" || ageEpoch=""
	case "$ageEpoch" in ''|*[!0123456789]*) return 0 ;; esac
	[ "$dashboardNow" -ge "$ageEpoch" ] || return 0
	dashboardAge=$(( dashboardNow - ageEpoch ))
	return 0
}

## WHAT IS SLOW TO READ AND CHANGES SELDOM IS KEPT, in the tooling's own temp folder of the
## workspace, .local/temp/mdat-manager-dashboard.<name>: two lines, `<read, seconds since
## 1970> <the words kept>` and then what they are said of, put in place by one rename, so no
## reader finds half of them. LocalToolsManagerDashboardKept gives the words in
## dashboardKept, rc 0, while they are of the same thing and younger than the seconds
## given; rc 1, and nothing, for anything else. LocalToolsManagerDashboardKeep keeps them,
## rc 1 where it cannot.
LocalToolsManagerDashboardKept(){ ## name, for how many seconds, what it is said of
	local keptFile="${MMDAPP%/}/.local/temp/mdat-manager-dashboard.$1" keptAsked="" keptWords="" keptOf=""
	dashboardKept=""
	[ -f "$keptFile" ] || return 1
	{ read -r keptAsked keptWords && IFS= read -r keptOf ; } < "$keptFile" 2> /dev/null || return 1
	case "$keptAsked" in ''|*[!0123456789]*|????????????*) return 1 ;; esac
	[ -n "$keptWords" ] && [ "$keptOf" = "$3" ] && [ "$dashboardNow" -ge "$keptAsked" ] && [ "$(( dashboardNow - keptAsked ))" -lt "$2" ] || return 1
	dashboardKept="$keptWords"
	return 0
}
LocalToolsManagerDashboardKeep(){ ## name, what it is said of, the words to keep
	local keepDir="${MMDAPP%/}/.local/temp" keepAside=""
	mkdir -p "$keepDir" 2> /dev/null || return 1
	keepAside="$( mktemp "$keepDir/mdat-manager-dashboard.$1.XXXXXX" 2> /dev/null )" || return 1
	{ printf '%s %s\n%s\n' "$dashboardNow" "$3" "$2" > "$keepAside" && chmod 644 "$keepAside" && mv -f "$keepAside" "$keepDir/mdat-manager-dashboard.$1" ; } 2> /dev/null || { rm -f "$keepAside" 2> /dev/null || : ; return 1 ; }
	return 0
}

## What a load average is of the processors, in dashboardShare, a whole number of percent
## that stops at 100, with its level by the thresholds of the load in dashboardLevel. Both
## read as nothing where the figure is no number or the processors are not known.
LocalToolsManagerDashboardLoad(){ ## load average, processors
	local loadWhole loadPart="00" loadPercent
	dashboardShare="" ; dashboardLevel="-"
	case "${1:-}" in ''|.*|*.*.*|*[!0123456789.]*) return 0 ;; esac
	case "${2:-}" in ''|*[!0123456789]*|0|????????*) return 0 ;; esac
	loadWhole="${1%%.*}"
	case "$1" in *.*) loadPart="${1#*.}00" ; loadPart="${loadPart:0:2}" ;; esac
	case "$loadWhole" in ????????*) return 0 ;; esac
	loadPercent=$(( ( 10#$loadWhole * 100 + 10#$loadPart ) / $2 ))
	LocalToolsManagerDashboardLevel "$loadPercent" "$localManagerDashboardLoadWarn" "$localManagerDashboardLoadBad"
	[ "$loadPercent" -le 100 ] || loadPercent=100
	dashboardShare="$loadPercent"
	return 0
}

## THE MACHINE, by what each system has for it, asked now and never kept. A figure the host
## gives no answer for is left out.
##   the load averages    uptime(1), on all three: `load averages: 1.20 1.10 1.00`, or
##                        `load average: 1.20, 1.10, 1.00`.
##   the processors       macOS, FreeBSD: sysctl hw.ncpu. Linux: getconf _NPROCESSORS_ONLN.
##   the memory           all of it, and what of it is free to use: the pages nothing holds
##                        and those that are given up when asked. Used is all less that.
##                        macOS: sysctl hw.memsize; vm_stat, its pages free, inactive and
##                        speculative, by its own page size. FreeBSD: sysctl hw.physmem,
##                        hw.pagesize, vm.stats.vm.v_free_count and v_inactive_count. Linux:
##                        /proc/meminfo, MemTotal and MemAvailable, and on a kernel with no
##                        MemAvailable MemFree, Buffers and Cached.
##   the uptime           macOS, FreeBSD: sysctl kern.boottime, `{ sec = <seconds> ...`,
##                        taken off now. Linux: /proc/uptime.
LocalToolsManagerDashboardMachine(){
	local machineKind machineText machineOne="" machineFive="" machineFifteen="" machineRest machineCpus="" machineTotal="" machineFree="" machineBoot="" machineUp="" machineUsed
	machineKind="$( uname -s 2> /dev/null )" || machineKind=""
	machineText="$( LC_ALL=C uptime 2> /dev/null )" || machineText=""
	case "$machineText" in
		*'load averages: '*) machineText="${machineText##*load averages: }" ;;
		*'load average: '*) machineText="${machineText##*load average: }" ;;
		*) machineText="" ;;
	esac
	machineText="${machineText//,/ }"
	read -r machineOne machineFive machineFifteen machineRest <<< "$machineText" || :
	case "$machineKind" in
		Darwin)
			machineCpus="$( sysctl -n hw.ncpu 2> /dev/null )" || machineCpus=""
			machineTotal="$( sysctl -n hw.memsize 2> /dev/null )" || machineTotal=""
			machineFree="$( LC_ALL=C vm_stat 2> /dev/null | LC_ALL=C awk '
				/page size of [0-9]+ bytes/ { pageBytes = $0 ; sub(/.*page size of /, "", pageBytes) ; sub(/ bytes.*/, "", pageBytes) ; }
				/^Pages (free|inactive|speculative):/ { pageCount = $NF ; sub(/\.$/, "", pageCount) ; if (pageCount ~ /^[0-9]+$/) { pagesFree += pageCount ; pagesSeen++ ; } }
				END { if (pageBytes > 0 && pagesSeen > 0) printf "%.0f\n", pagesFree * pageBytes ; }
			' )" || machineFree=""
			machineBoot="$( sysctl -n kern.boottime 2> /dev/null )" || machineBoot=""
		;;
		FreeBSD)
			machineCpus="$( sysctl -n hw.ncpu 2> /dev/null )" || machineCpus=""
			machineTotal="$( sysctl -n hw.physmem 2> /dev/null )" || machineTotal=""
			machineFree="$( sysctl -n hw.pagesize vm.stats.vm.v_free_count vm.stats.vm.v_inactive_count 2> /dev/null | LC_ALL=C awk '
				NR == 1 { pageBytes = $1 ; next ; }
				$1 ~ /^[0-9]+$/ { pagesFree += $1 ; pagesSeen++ ; }
				END { if (pageBytes > 0 && pagesSeen > 0) printf "%.0f\n", pagesFree * pageBytes ; }
			' )" || machineFree=""
			machineBoot="$( sysctl -n kern.boottime 2> /dev/null )" || machineBoot=""
		;;
		Linux)
			machineCpus="$( getconf _NPROCESSORS_ONLN 2> /dev/null )" || machineCpus=""
			if [ -r /proc/meminfo ] ; then
				read -r machineTotal machineFree machineRest <<< "$( LC_ALL=C awk '
					$1 == "MemTotal:" { memTotal = $2 ; }
					$1 == "MemAvailable:" { memAvailable = $2 ; memSaid = 1 ; }
					$1 == "MemFree:" || $1 == "Buffers:" || $1 == "Cached:" { memLoose += $2 ; }
					END { if (memTotal > 0) printf "%.0f %.0f\n", memTotal * 1024, ( memSaid ? memAvailable : memLoose ) * 1024 ; }
				' /proc/meminfo 2> /dev/null )" || :
			fi
			if [ -r /proc/uptime ] ; then
				{ read -r machineUp machineRest < /proc/uptime ; } 2> /dev/null || :
				machineUp="${machineUp%%.*}"
			fi
		;;
	esac
	case "$machineBoot" in
		*'sec = '[0123456789]*)
			machineBoot="${machineBoot#*sec = }" ; machineBoot="${machineBoot%%[!0123456789]*}"
			case "$machineBoot" in ????????????*) ;; *) [ "$dashboardNow" -lt "$machineBoot" ] || machineUp=$(( dashboardNow - machineBoot )) ;; esac
		;;
	esac
	case "$machineCpus" in ''|*[!0123456789]*|0|????????*) machineCpus="" ;; esac
	case "$machineOne" in ''|.*|*.*.*|*[!0123456789.]*) ;; *)
		LocalToolsManagerDashboardLoad "$machineOne" "$machineCpus"
		LocalToolsManagerDashboardFigure machine load-1 "Load One Minute" "$machineOne" - "$dashboardLevel" "$dashboardShare"
	;; esac
	case "$machineFive" in ''|.*|*.*.*|*[!0123456789.]*) ;; *)
		LocalToolsManagerDashboardLoad "$machineFive" "$machineCpus"
		LocalToolsManagerDashboardFigure machine load-5 "Load Five Minutes" "$machineFive" - "$dashboardLevel" "$dashboardShare"
	;; esac
	case "$machineFifteen" in ''|.*|*.*.*|*[!0123456789.]*) ;; *)
		LocalToolsManagerDashboardLoad "$machineFifteen" "$machineCpus"
		LocalToolsManagerDashboardFigure machine load-15 "Load Fifteen Minutes" "$machineFifteen" - "$dashboardLevel" "$dashboardShare"
	;; esac
	[ -z "$machineCpus" ] || LocalToolsManagerDashboardFigure machine processors "Processors Online" "$machineCpus" count - ""
	case "$machineTotal" in ''|*[!0123456789]*|0|??????????????????*) machineTotal="" ;; esac
	case "$machineFree" in ''|*[!0123456789]*|??????????????????*) machineFree="" ;; esac
	if [ -n "$machineTotal" ] && [ -n "$machineFree" ] && [ "$machineFree" -le "$machineTotal" ] ; then
		machineUsed=$(( machineTotal - machineFree ))
		LocalToolsManagerDashboardShare "$(( machineUsed / 1024 ))" "$(( machineTotal / 1024 ))"
		LocalToolsManagerDashboardLevel "$dashboardShare" "$localManagerDashboardMemoryWarn" "$localManagerDashboardMemoryBad"
		LocalToolsManagerDashboardFigure machine memory-used "Memory In Use" "$machineUsed" bytes "$dashboardLevel" "$dashboardShare"
		LocalToolsManagerDashboardFigure machine memory-free "Memory To Use" "$machineFree" bytes - ""
	fi
	case "$machineUp" in ''|*[!0123456789]*|????????????*) ;; *) LocalToolsManagerDashboardFigure machine uptime "Machine Up For" "$machineUp" seconds - "" ;; esac
	return 0
}

## DISK SPACE, by df(1) in the one form all three systems share (`df -k -P`), of the volume
## each of these lies on: the workspace, the tooling's own temp folder of it, and the volumes
## the subsystem that registers it adds (localManagerDashboardDiskVolumes). A volume is printed
## once, under the first of them that lies on it, so a later one has rows of its own only on
## another volume. Of each: its size, what is used with the share df gives for it and a level
## by the thresholds of a volume, and what is free.
LocalToolsManagerDashboardDisk(){
	local diskNames="" diskLabels="" diskName diskLabel diskPath diskAt diskBlocks diskUsed diskFree diskShare diskMount diskSeen=$'\n' diskTab=$'\t'
	set --
	while IFS="$diskTab" read -r diskName diskLabel diskPath ; do
		[ -n "$diskPath" ] && [ -d "$diskPath" ] || continue
		set -- "$@" "$diskPath"
		diskNames="$diskNames$diskName " ; diskLabels="$diskLabels$diskLabel "
	done <<< "workspace${diskTab}Workspace_Volume${diskTab}${MMDAPP%/}
temp${diskTab}Temp_Folder_Volume${diskTab}${MMDAPP%/}/.local/temp${localManagerDashboardDiskVolumes:+
$localManagerDashboardDiskVolumes}"
	[ $# -gt 0 ] || return 0
	## One line a folder, in the order asked: which it is, blocks of 1024 in all, used and free, the share used, the mount.
	while IFS="$diskTab" read -r diskAt diskBlocks diskUsed diskFree diskShare diskMount ; do
		case "$diskAt" in ''|*[!0123456789]*) continue ;; esac
		case "$diskBlocks$diskUsed$diskFree$diskShare" in ''|*[!0123456789]*) continue ;; esac
		[ -n "$diskMount" ] || continue
		diskName="$diskNames" ; diskLabel="$diskLabels"
		while [ "$diskAt" -gt 1 ] ; do diskName="${diskName#* }" ; diskLabel="${diskLabel#* }" ; diskAt=$(( diskAt - 1 )) ; done
		diskName="${diskName%% *}" ; diskLabel="${diskLabel%% *}"
		[ -n "$diskName" ] || continue
		case "$diskSeen" in *$'\n'"$diskMount"$'\n'*) continue ;; esac
		diskSeen="$diskSeen$diskMount"$'\n'
		[ "$diskShare" -le 100 ] || diskShare=100
		LocalToolsManagerDashboardLevel "$diskShare" "$localManagerDashboardDiskWarn" "$localManagerDashboardDiskBad"
		LocalToolsManagerDashboardFigure disk "$diskName-size" "${diskLabel}_Size" "$(( diskBlocks * 1024 ))" bytes - ""
		LocalToolsManagerDashboardFigure disk "$diskName-used" "${diskLabel}_Used" "$(( diskUsed * 1024 ))" bytes "$dashboardLevel" "$diskShare"
		LocalToolsManagerDashboardFigure disk "$diskName-free" "${diskLabel}_Free" "$(( diskFree * 1024 ))" bytes - ""
	done <<< "$( LC_ALL=C df -k -P "$@" 2> /dev/null | LC_ALL=C awk -v diskTab="$diskTab" '
		NR == 1 { next ; }
		{
			## The name of a file system and of a mount may hold blanks: the row is found by its share, `<n>%`, after three numbers.
			for (shareAt = 5 ; shareAt <= NF ; shareAt++) {
				if ($shareAt ~ /^[0-9]+%$/ && $(shareAt - 1) ~ /^[0-9]+$/ && $(shareAt - 2) ~ /^[0-9]+$/ && $(shareAt - 3) ~ /^[0-9]+$/) break ;
			}
			if (shareAt > NF || shareAt == NF) next ;
			mountText = $(shareAt + 1) ;
			for (mountAt = shareAt + 2 ; mountAt <= NF ; mountAt++) mountText = mountText " " $mountAt ;
			shareText = $shareAt ; sub(/%$/, "", shareText) ;
			printf "%d%s%s%s%s%s%s%s%s%s%s\n", NR - 1, diskTab, $(shareAt - 3), diskTab, $(shareAt - 2), diskTab, $(shareAt - 1), diskTab, shareText, diskTab, mountText ;
		}
	' )"
	return 0
}

case "$1" in

	## The panels of one group of the Dashboard, each with its figures, as the list file of the console declares them: TAB-separated rows a screen reads.
	## With no group the Dashboard itself (`root`), and after its panels a `group` row for each submenu that applies on this host. Their form is the help entry's.
	--manager-dashboard-read)
		local readOp="$1" readGroup="root" readName readOne readKnown="" readFound readWanted=" " readList="${managerConsoleDashboardList:-}" readLine readKind readGroupOf readPanel readLabel readReader readInclude readNamed readWhen
		local readPanels="" readGroups="" readTab=$'\t' readCount
		local dashboardRows="" dashboardCount=0 dashboardNow="" dashboardToday="" dashboardLevel="-" dashboardShare="" dashboardAge="" dashboardKept=""
		shift
		if [ "${1:-}" = "--group" ] ; then
			if [ $# -lt 2 ] || [ -z "$2" ] ; then
				echo "⛔ ERROR: $MDSC_CMD $readOp: --group needs a group -- nothing was printed" >&2
				set +e ; return 1
			fi
			readGroup="$2" ; shift 2
		fi
		if [ -z "$readList" ] || [ ! -f "$readList" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $readOp: the list of panels of this console is not there${readList:+ ($readList)} -- nothing was printed" >&2
			set +e ; return 1
		fi
		## The two kinds of line of the list, each in the order of the list.
		readPanels="$( LC_ALL=C awk -F'\t' -v wantGroup="$readGroup" '$1 == "panel" && $2 == wantGroup && NF >= 7 { print }' "$readList" )"
		readGroups="$( LC_ALL=C awk -F'\t' '$1 == "group" && NF >= 5 { print }' "$readList" )"
		if [ "$readGroup" != "root" ] ; then
			readFound="false"
			while IFS="$readTab" read -r readKind readGroupOf readLabel readWhen readInclude ; do
				[ "$readKind" = "group" ] && [ "$readGroupOf" = "$readGroup" ] && readFound="true"
			done <<< "$readGroups"
			if [ "$readFound" != "true" ] ; then
				readKnown="root"
				while IFS="$readTab" read -r readKind readGroupOf readLabel readWhen readInclude ; do
					[ "$readKind" = "group" ] && readKnown="$readKnown $readGroupOf"
				done <<< "$readGroups"
				echo "⛔ ERROR: $MDSC_CMD $readOp: the group given is none of its groups -- nothing was printed. Its groups: ${readKnown// /, }" >&2
				set +e ; return 1
			fi
		fi
		readKnown=""
		while IFS="$readTab" read -r readKind readGroupOf readPanel readLabel readReader readInclude readNamed ; do
			[ -n "$readPanel" ] || continue
			readKnown="$readKnown${readKnown:+ }$readPanel"
		done <<< "$readPanels"
		for readName in "$@" ; do
			readFound="false"
			for readOne in $readKnown ; do
				[ "$readOne" != "$readName" ] || readFound="true"
			done
			if [ "$readFound" != "true" ] ; then
				echo "⛔ ERROR: $MDSC_CMD $readOp: a word given is none of its blocks -- nothing was printed. Its blocks: ${readKnown// /, }" >&2
				set +e ; return 1
			fi
			readWanted="$readWanted$readName "
		done
		## with no name, every panel of the group but those printed only where they are named
		if [ $# -eq 0 ] ; then
			while IFS="$readTab" read -r readKind readGroupOf readPanel readLabel readReader readInclude readNamed ; do
				[ -n "$readPanel" ] || continue
				[ "$readNamed" = "named" ] || readWanted="$readWanted$readPanel "
			done <<< "$readPanels"
		fi
		## The readers are all there before the first block is printed: a reader the list names that is none is refused whole.
		while IFS="$readTab" read -r readKind readGroupOf readPanel readLabel readReader readInclude readNamed ; do
			[ -n "$readPanel" ] || continue
			case "$readWanted" in *" $readPanel "*) ;; *) continue ;; esac
			[ "$readInclude" = "-" ] || . "$MDLT_ORIGIN/myx/$readInclude"
			if ! type "$readReader" > /dev/null 2>&1 ; then
				echo "⛔ ERROR: $MDSC_CMD $readOp: the reader $readReader of the panel $readPanel is not defined${readInclude:+ in $readInclude} -- nothing was printed" >&2
				set +e ; return 1
			fi
		done <<< "$readPanels"
		## Now, once for every figure of the call: seconds since 1970, and this host's date of today.
		read -r dashboardNow dashboardToday <<< "$( date '+%s %Y-%m-%d' 2> /dev/null )" || :
		case "$dashboardNow" in ''|*[!0123456789]*) dashboardNow=0 ;; esac
		while IFS="$readTab" read -r readKind readGroupOf readPanel readLabel readReader readInclude readNamed ; do
			[ -n "$readPanel" ] || continue
			case "$readWanted" in *" $readPanel "*) ;; *) continue ;; esac
			dashboardRows="" ; dashboardCount=0
			"$readReader" || :
			[ "$dashboardCount" -gt 0 ] || continue
			printf 'block\t%s\t%s\t%s\n%s' "$readPanel" "$readLabel" "$dashboardCount" "$dashboardRows"
		done <<< "$readPanels"
		## The Dashboard itself ends with its submenus, each that applies on this host: how many panels it holds.
		if [ "$readGroup" = "root" ] && [ $# -eq 0 ] ; then
			while IFS="$readTab" read -r readKind readGroupOf readLabel readWhen readInclude ; do
				[ "$readKind" = "group" ] && [ -n "$readGroupOf" ] || continue
				if [ "$readWhen" != "-" ] ; then
					[ "$readInclude" = "-" ] || . "$MDLT_ORIGIN/myx/$readInclude"
					type "$readWhen" > /dev/null 2>&1 && "$readWhen" || continue
				fi
				readCount="$( LC_ALL=C awk -F'\t' -v wantGroup="$readGroupOf" '$1 == "panel" && $2 == wantGroup && NF >= 7 { found++ } END { print found + 0 }' "$readList" )"
				printf 'group\t%s\t%s\t%s\n' "$readGroupOf" "$readLabel" "$readCount"
			done <<< "$readGroups"
		fi
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
