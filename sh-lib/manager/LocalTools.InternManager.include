#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## LocalTools.InternManager.include -- the manager screen start shared by the four sibling
## consoles (F12.2): starts sh-lib/manager/AgentsManagerScreen.py of the agents package in this
## terminal, as the app the dispatcher names. Sourced by the `--manager` arm of a sibling's
## dispatcher, with $MDSC_CMD its command name; the app, its package and its tools are derived
## from it, so no sibling copies the start. The agents console keeps its own start
## (AgentsTools.InternManager.include); this one is the siblings', one start, not four.
##
## It hands the screen the interface style of the start, and the spacers and the mouse of the
## console settings it shares (`.local`'s own). The screen itself says, in one line, where it
## cannot start: a Python with no curses module, or no terminal.
##

case "$1" in

	--manager)
		shift

		## Its one option: the interface style of this start alone, handed on as it is given.
		local managerStyle=""
		if [ "${1:-}" = "--style" ] && [ $# -eq 2 ] && [ -n "$2" ] ; then
			managerStyle="$2"
			shift 2
		fi

		if [ $# -gt 0 ] ; then
			printf '%s\n' "$MDSC_CMD --manager -- starts the manager screen of this console in this terminal. Its one option is --style <name>, the interface style of this start." >&2
			printf '%s\n' "" >&2
			printf '%s\n' "  $MDSC_CMD --manager [--style <name>]" >&2
			set +e ; return 1
		fi

		set +e

		local managerConsoleApp managerConsolePackage managerScreenFile managerSpacers managerMouse
		managerConsoleApp="$( printf '%s' "${MDSC_CMD#Distro}" | sed 's/Tools$//' | tr '[:upper:]' '[:lower:]' )"
		managerConsolePackage="myx.distro-$managerConsoleApp"
		[ "$managerConsoleApp" != "local" ] || managerConsolePackage="myx.distro-.local"

		managerScreenFile="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsManagerScreen.py"
		if [ ! -r "$managerScreenFile" ] ; then
			echo "$MDSC_CMD --manager: ⛔ ERROR: the manager screen is missing or unreadable: $managerScreenFile" >&2
			return 1
		fi
		if ! command -v python3 > /dev/null 2>&1 ; then
			echo "$MDSC_CMD --manager: ⛔ ERROR: the manager screen needs python3, and none is in PATH." >&2
			return 1
		fi

		## THE SPACERS OF THIS START: MDLT_CONSOLE_SPACERS, a console setting of .local, the
		## user's own, beside MDLT_CONSOLE_HISTORY. `disable` turns off the blank lines between
		## the groups of the screen's lists. The one the environment names first, which the
		## screen reads itself; else the one the user saved, handed on in the screen's
		## environment alone.
		if [ -z "${MDLT_CONSOLE_SPACERS:-}" ] ; then
			managerSpacers="$( set -- --.local-config-option-select-default MDLT_CONSOLE_SPACERS "" ; . "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/LocalTools.Config.include" 2> /dev/null < /dev/null )" || managerSpacers=""
			[ -z "$managerSpacers" ] || local -x MDLT_CONSOLE_SPACERS="$managerSpacers"
		fi

		## THE MOUSE OF THIS START: MDLT_CONSOLE_MOUSE, beside the spacers and read the same way,
		## a console setting of .local. `disable` leaves the mouse to the terminal.
		if [ -z "${MDLT_CONSOLE_MOUSE:-}" ] ; then
			managerMouse="$( set -- --.local-config-option-select-default MDLT_CONSOLE_MOUSE "" ; . "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/LocalTools.Config.include" 2> /dev/null < /dev/null )" || managerMouse=""
			[ -z "$managerMouse" ] || local -x MDLT_CONSOLE_MOUSE="$managerMouse"
		fi

		set -- --workspace "$MMDAPP" --tools "$MDLT_ORIGIN/myx/$managerConsolePackage/sh-scripts/$MDSC_CMD.fn.sh" --app "$managerConsoleApp"
		[ -z "$managerStyle" ] || set -- "$@" --style "$managerStyle"

		## -I: nothing of the caller's own Python setup reaches the screen. -B: no bytecode is written into the source tree.
		python3 -I -B "$managerScreenFile" "$@"
		return $?
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;

esac
