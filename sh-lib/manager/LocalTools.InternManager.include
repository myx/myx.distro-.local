#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## LocalTools.InternManager.include -- the manager screen start shared by the four sibling
## consoles (F12.2): starts the manager screen, sh-lib/manager/LocalManagerScreen.py of this
## package, in this terminal. Sourced by the `--manager` arm of a
## sibling's dispatcher, with $MDSC_CMD its command name; the app is derived from it, so no sibling
## copies the start. The screen is the whole family's app, and no package of another family is
## needed to start it. The screen reads
## through the dispatcher of this console's own package, the very file the user typed `--manager` on,
## so this console answers its own manager operations. The agents console keeps its own start
## (AgentsTools.InternManager.include); this one is the siblings', one start, not four.
##
## It hands the screen the interface style of the start, and the spacers and the mouse of the
## console settings it shares (`.local`'s own). The screen itself says, in one line, where it
## cannot start: a Python with no curses module, or no terminal.
##

type LocalToolsManagerConsoleApp > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/manager/LocalTools.ManagerName.include"

case "$1" in

	--manager)
		shift

		## Its one option: the interface style of this start alone, handed on as it is given.
		local managerStyle=""
		if [ "${1:-}" = "--style" ] && [ $# -eq 2 ] && [ -n "$2" ] ; then
			managerStyle="$2"
			shift 2
		fi

		if [ $# -gt 0 ] ; then
			printf '%s\n' "$MDSC_CMD --manager -- starts the manager screen of this console in this terminal. Its one option is --style <name>, the interface style of this start." >&2
			printf '%s\n' "" >&2
			printf '%s\n' "  $MDSC_CMD --manager [--style <name>]" >&2
			set +e ; return 1
		fi

		set +e

		local managerConsoleApp managerScreenFile managerSpacers managerMouse managerConsolePackage managerConsoleTools

		## THE STYLE OF THIS START, read from .local's own setting: what the user saved in this workspace,
		## under its own name or the one it had before, as that reader applies both. A name --style gave is
		## already in managerStyle and is never overridden. Where nothing is saved, the screen keeps its own default.
		if [ -z "$managerStyle" ] ; then
			managerStyle="$( set -- --.local-config-option-select-default MDLT_MANAGER_STYLE "" ; . "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/LocalTools.Config.include" 2> /dev/null < /dev/null )" || managerStyle=""
		fi
		managerConsoleApp="$( LocalToolsManagerConsoleApp )"

		## THE TOOL FILE FOLLOWS THE APP: the screen reads through the dispatcher of this console's own package,
		## `myx.distro-<app>`, which is the file the user typed `--manager` on, so this console answers the
		## operations the screen reads.
		managerConsolePackage="$( LocalToolsManagerConsolePackage )"
		managerConsoleTools="$MDLT_ORIGIN/myx/$managerConsolePackage/sh-scripts/$MDSC_CMD.fn.sh"

		managerScreenFile="$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/manager/LocalManagerScreen.py"
		if [ ! -r "$managerScreenFile" ] ; then
			echo "$MDSC_CMD --manager: ⛔ ERROR: the manager screen file is missing from this install, so nothing was started ($managerScreenFile)" >&2
			return 1
		fi
		if ! command -v python3 > /dev/null 2>&1 ; then
			echo "$MDSC_CMD --manager: ⛔ ERROR: the manager screen needs python3, and none is in PATH." >&2
			return 1
		fi

		## THE SPACERS OF THIS START: MDLT_MANAGER_SPACERS, a console setting of .local, the
		## user's own, beside MDLT_CONSOLE_HISTORY. `disable` turns off the blank lines between
		## the groups of the screen's lists. The one the environment names first, which the
		## screen reads itself; else the one the user saved, handed on in the screen's
		## environment alone.
		if [ -z "${MDLT_MANAGER_SPACERS:-}" ] ; then
			managerSpacers="$( set -- --.local-config-option-select-default MDLT_MANAGER_SPACERS "" ; . "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/LocalTools.Config.include" 2> /dev/null < /dev/null )" || managerSpacers=""
			[ -z "$managerSpacers" ] || local -x MDLT_MANAGER_SPACERS="$managerSpacers"
		fi

		## THE MOUSE OF THIS START: MDLT_MANAGER_MOUSE, beside the spacers and read the same way,
		## a console setting of .local. `disable` leaves the mouse to the terminal.
		if [ -z "${MDLT_MANAGER_MOUSE:-}" ] ; then
			managerMouse="$( set -- --.local-config-option-select-default MDLT_MANAGER_MOUSE "" ; . "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/LocalTools.Config.include" 2> /dev/null < /dev/null )" || managerMouse=""
			[ -z "$managerMouse" ] || local -x MDLT_MANAGER_MOUSE="$managerMouse"
		fi

		set -- --workspace "$MMDAPP" --tools "$managerConsoleTools" --app "$managerConsoleApp"
		[ -z "$managerStyle" ] || set -- "$@" --style "$managerStyle"

		## -I: nothing of the caller's own Python setup reaches the screen. -B: no bytecode is written into the source tree.
		python3 -I -B "$managerScreenFile" "$@"
		return $?
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;

esac
