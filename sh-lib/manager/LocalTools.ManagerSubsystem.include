#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## LocalTools.ManagerSubsystem.include -- the --manager-subsystem-* operations (F11.7 of the refactorings epic): the subsystems of
## the tool family, which are installed in this workspace and which are not, and installing and uninstalling one. Owned by `.local`,
## which installs the rest, and sourced by the `--manager-subsystem-*)` arm of the dispatcher of any subsystem's console, each of
## which says in `managerConsoleSubsystem` which subsystem it is (agents, source, ...): the console is never uninstalled from itself.
##
## THE SUBSYSTEMS: `.local`, `system`, `deploy`, `source`, `remote` and `agents`. One is installed where its installed copy stands in
## `.local/myx` of the workspace. `.local` is the base that installs the rest, and `system` is shared by source and deploy and comes
## with either: neither has a command of its own. The four that do are installed by DistroLocalTools.fn.sh --install-distro-<name>
## and uninstalled by --uninstall-distro-<name>. Nothing is run here but those two commands of the local tools.
##

## The subsystems, in the order the console lists them.
localManagerSubsystems=".local system deploy source remote agents"

## The tool that installs and uninstalls, and the place of a subsystem's installed copy.
LocalToolsManagerSubsystemTool(){
	printf '%s\n' "${MDAT_MANAGER_LOCAL_TOOLS:-$MDLT_ORIGIN/myx/myx.distro-.local/sh-scripts/DistroLocalTools.fn.sh}"
}
LocalToolsManagerSubsystemDir(){ ## name
	printf '%s\n' "${MMDAPP%/}/.local/myx/myx.distro-$1"
}

## The row of one subsystem: `subsystem <name> <state> <role> <install> <uninstall> <update>`.
##   <state>      `installed`, or `missing`
##   <role>       why it has no command of its own, or `-`: `base` (.local), `shared` (system), `console` (the console that is asking)
##   <install>    `yes` where the command to install it is offered: a toolset that is missing
##   <uninstall>  `yes` where the command to uninstall it is offered: a toolset that is installed and is not the console's own
##   <update>     `yes` where the command to update it is offered: a toolset that is installed and has a command of its own, which is its install again
##                (it pulls its copy): any of the four, the console's own included; `.local` and `system` are updated with all of them
LocalToolsManagerSubsystemRow(){ ## name
	local rowState="missing" rowRole="-" rowInstall="no" rowUninstall="no" rowUpdate="no"
	[ ! -d "$( LocalToolsManagerSubsystemDir "$1" )/sh-scripts" ] || rowState="installed"
	case "$1" in
		.local) rowRole="base" ;;
		system) rowRole="shared" ;;
		*)
			[ "$1" != "${managerConsoleSubsystem:-}" ] || rowRole="console"
			[ "$rowState" != "missing" ] || rowInstall="yes"
			[ "$rowState" != "installed" ] || [ "$rowRole" = "console" ] || rowUninstall="yes"
			[ "$rowState" != "installed" ] || rowUpdate="yes"
		;;
	esac
	printf 'subsystem\t%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$rowState" "$rowRole" "$rowInstall" "$rowUninstall" "$rowUpdate"
}

case "$1" in

	## The subsystems and what may be done with each. Its form is the help entry's.
	--manager-subsystem-list)
		local listName
		[ $# -eq 1 ] || { echo "⛔ ERROR: $MDSC_CMD $1: syntax is $1, got $(( $# - 1 )) argument(s) -- nothing is shown" >&2 ; set +e ; return 1 ; }
		for listName in $localManagerSubsystems ; do
			LocalToolsManagerSubsystemRow "$listName"
		done
		return 0
	;;

	## One subsystem's repository and its user manual (C1 of the refactorings epic): the README.md of its package,
	## read from its installed copy where that stands, else from the source tree of the origin. The repository is the
	## address its project.inf declares under `distro-image-sync:source-prepare-pull:repo:`, which is what the package
	## is pulled from; a package that declares none has none. Nothing is reached, and nothing is written.
	--manager-subsystem-read)
		local readOp="$1" readName readFound="" readDir readFile readRepo readReadme
		shift
		[ $# -eq 1 ] || { echo "⛔ ERROR: $MDSC_CMD $readOp: syntax is $readOp <subsystem>, got $# argument(s) -- nothing is shown" >&2 ; set +e ; return 1 ; }
		for readName in $localManagerSubsystems ; do [ "$readName" != "$1" ] || readFound="yes" ; done
		[ -n "$readFound" ] || { echo "⛔ ERROR: $MDSC_CMD $readOp: the subsystem given is none of the subsystems of this family -- nothing was shown. They are ${localManagerSubsystems// /, }" >&2 ; set +e ; return 1 ; }
		readDir="$( LocalToolsManagerSubsystemDir "$1" )"
		[ -f "$readDir/project.inf" ] || readDir="$MDLT_ORIGIN/myx/myx.distro-$1"
		readRepo="$( LC_ALL=C grep -m1 'source-prepare-pull:repo:' "$readDir/project.inf" 2> /dev/null )" || readRepo=""
		if [ -n "$readRepo" ] ; then
			## <path>:<branch>:<url>, the url the rest after the first two colons; the url itself may hold colons
			readRepo="${readRepo#*repo:}" ; readRepo="${readRepo#*:}" ; readRepo="${readRepo#*:}"
			readRepo="${readRepo%%[[:space:]]*}"
		fi
		readReadme="$readDir/README.md"
		printf 'repository\t%s\n' "${readRepo:--}"
		printf 'readme\t%s\n' "$readReadme"
		[ -f "$readReadme" ] || return 0
		cat "$readReadme" || { set +e ; return 1 ; }
		return 0
	;;

	## One command of a subsystem, run with the output it writes, the exit status its own: install a toolset that is missing, uninstall
	## one that is installed and is not the console's own, update one that is installed (its install again, which pulls its copy), or update
	## them all with the local tools (`update all`: Update Local Tools, --upgrade-installed-tools). A command its row does not offer is refused and nothing is run.
	--manager-subsystem-run)
		local runOp="$1" runWhat="${2:-}" runName="${3:-}" runRow runFound="" runField1 runField2 runState runRole runInstall runUninstall runUpdate runTool runCommand=""
		[ $# -eq 3 ] || { echo "⛔ ERROR: $MDSC_CMD $runOp: syntax is $runOp (install|uninstall|update) <subsystem>, or $runOp update all, got $(( $# - 1 )) argument(s) -- nothing was run" >&2 ; set +e ; return 1 ; }
		case "$runWhat" in install|uninstall|update) ;; *) echo "⛔ ERROR: $MDSC_CMD $runOp: the command given is none of install, uninstall and update -- nothing was run" >&2 ; set +e ; return 1 ;; esac
		if [ "$runWhat:$runName" = "update:all" ] ; then
			runCommand="--upgrade-installed-tools"
		else
			for runRow in $localManagerSubsystems ; do
				[ "$runRow" = "$runName" ] || continue
				runFound="yes"
			done
			[ -n "$runFound" ] || { echo "⛔ ERROR: $MDSC_CMD $runOp: the subsystem given is none of the subsystems of this family -- nothing was run. They are ${localManagerSubsystems// /, }" >&2 ; set +e ; return 1 ; }
			IFS=$'\t' read -r runField1 runField2 runState runRole runInstall runUninstall runUpdate <<< "$( LocalToolsManagerSubsystemRow "$runName" )"
			case "$runWhat:$runInstall:$runUninstall:$runUpdate" in
				install:yes:*:*|uninstall:*:yes:*|update:*:*:yes) runCommand="--$runWhat-distro-$runName" ; [ "$runWhat" != update ] || runCommand="--install-distro-$runName" ;;
				*)
					case "$runRole:$runWhat" in
						base:update) echo "⛔ ERROR: $MDSC_CMD $runOp: $runName is the base, and is updated with all the others: $runOp update all -- nothing was run" >&2 ;;
						shared:update) echo "⛔ ERROR: $MDSC_CMD $runOp: $runName is shared by source and deploy and has no command of its own: it is updated with all the others -- nothing was run" >&2 ;;
						base:*) echo "⛔ ERROR: $MDSC_CMD $runOp: $runName is the base that installs the rest, and is neither installed nor uninstalled here -- nothing was run" >&2 ;;
						shared:*) echo "⛔ ERROR: $MDSC_CMD $runOp: $runName is shared by source and deploy and comes with either, so it has no command of its own -- nothing was run" >&2 ;;
						console:uninstall) echo "⛔ ERROR: $MDSC_CMD $runOp: $runName is the console that asks, and is not uninstalled from itself -- nothing was run" >&2 ;;
						*) echo "⛔ ERROR: $MDSC_CMD $runOp: $runWhat is not offered for $runName, which is $runState -- nothing was run" >&2 ;;
					esac
					set +e ; return 1
				;;
			esac
		fi
		runTool="$( LocalToolsManagerSubsystemTool )"
		[ -f "$runTool" ] || { echo "⛔ ERROR: $MDSC_CMD $runOp: the local tools are not at $runTool -- nothing was run" >&2 ; set +e ; return 1 ; }
		bash "$runTool" "$runCommand"
		return $?
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
